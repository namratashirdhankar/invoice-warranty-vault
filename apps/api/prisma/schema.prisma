generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id        String    @id @default(cuid())
  email     String    @unique
  passwordHash String
  invoices  Invoice[]
  products  Product[]
  createdAt DateTime  @default(now())
}
model Invoice {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  invoiceNumber String?
  seller        String?
  purchaseDate  DateTime?
  currency      String        @default("INR")
  total         Decimal?      @db.Decimal(12,2)
  fileKey       String
  mimeType      String
  status        String        @default("PENDING_REVIEW")
  items         InvoiceItem[]
  createdAt     DateTime      @default(now())
  @@index([userId, purchaseDate])
}
model Product {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  name          String
  brand         String?
  model         String?
  serialNumber  String?
  category      String?
  items         InvoiceItem[]
  support       SupportContact[]
  createdAt     DateTime      @default(now())
  @@index([userId, name])
}
model InvoiceItem {
  id         String    @id @default(cuid())
  invoiceId  String
  invoice    Invoice   @relation(fields: [invoiceId], references: [id])
  productId  String
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Int       @default(1)
  unitPrice  Decimal?  @db.Decimal(12,2)
  warranty   Warranty?
}
model Warranty {
  id           String      @id @default(cuid())
  itemId       String      @unique
  item         InvoiceItem @relation(fields: [itemId], references: [id])
  startsAt     DateTime?
  expiresAt    DateTime?
  source       String      @default("UNKNOWN")
  coverageNote String?
  reminderSent DateTime?
  @@index([expiresAt])
}
model SupportContact {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  name        String
  phone       String?
  email       String?
  website     String?
  sourceUrl   String?
  verifiedAt  DateTime?
}
