DATABASE_URL=postgresql://vault:vault_dev_only@localhost:5432/invoice_vault?schema=public
PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Comma-separated Web, Android, and iOS OAuth client IDs accepted as Google ID-token audiences.
GOOGLE_CLIENT_IDS=
# Currently supported: gemini. API_KEY belongs to the selected provider.
AI_PROVIDER=gemini
API_KEY=
# Optional Gemini model override (default: gemini-flash-lite-latest)
AI_MODEL=
UPLOAD_DIR=./uploads

# Optional: enable private AWS S3 storage. If omitted, local disk is used for development only.
AWS_REGION=ap-south-1
S3_BUCKET=
ENABLE_REMINDERS=false
