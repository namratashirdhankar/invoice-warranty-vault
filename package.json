{
  "name": "invoice-warranty-vault",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @vault/api",
    "dev:api": "npm run start:dev -w @vault/api",
    "dev:mobile": "npm run start -w @vault/mobile",
    "db:generate": "npm run prisma:generate -w @vault/api",
    "db:push": "npm run prisma:push -w @vault/api"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8"
  }
}
